# Copy to .env (or export these) for mainnet. Never commit real values.
# Testnet defaults work with zero config — this file is for the mainnet move.

# Your receiving wallet on Base (PUBLIC address only — never a private key)
X402_PAY_TO=0xYourReceivingAddress

# Price per call, e.g. "$0.01", "$0.05"
X402_PRICE=$0.01

# Mainnet: eip155:8453 (Base). Testnet default: eip155:84532 (Base Sepolia)
X402_NETWORK=eip155:8453

# Mainnet facilitator (needs CDP account + API key). Testnet: https://x402.org/facilitator
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

PORT=4021
